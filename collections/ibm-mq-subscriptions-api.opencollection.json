{
  "opencollection": "1.0.0",
  "info": {
    "name": "IBM MQ Administration REST Channels Subscriptions API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Subscriptions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "IBM MQ List subscriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}:{port}/ibmmq/rest/v2/admin/qmgr/:qmgrName/subscription",
            "headers": [
              {
                "name": "ibm-mq-rest-csrf-token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "qmgrName",
                "value": "",
                "type": "path",
                "description": "Name of the queue manager"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter subscriptions by name (supports wildcard *)"
              },
              {
                "name": "attributes",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of attributes to return"
              }
            ]
          },
          "docs": "Retrieve a list of subscriptions defined on a queue manager, with optional filtering by name."
        },
        {
          "info": {
            "name": "IBM MQ Create a subscription",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{host}:{port}/ibmmq/rest/v2/admin/qmgr/:qmgrName/subscription",
            "headers": [
              {
                "name": "ibm-mq-rest-csrf-token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "qmgrName",
                "value": "",
                "type": "path",
                "description": "Name of the queue manager"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new durable subscription on the specified queue manager."
        },
        {
          "info": {
            "name": "IBM MQ Get subscription details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}:{port}/ibmmq/rest/v2/admin/qmgr/:qmgrName/subscription/:subscriptionId",
            "headers": [
              {
                "name": "ibm-mq-rest-csrf-token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "qmgrName",
                "value": "",
                "type": "path",
                "description": "Name of the queue manager"
              },
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path",
                "description": "Subscription identifier"
              },
              {
                "name": "attributes",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of attributes to return"
              }
            ]
          },
          "docs": "Retrieve detailed information about a specific subscription."
        },
        {
          "info": {
            "name": "IBM MQ Delete a subscription",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{host}:{port}/ibmmq/rest/v2/admin/qmgr/:qmgrName/subscription/:subscriptionId",
            "headers": [
              {
                "name": "ibm-mq-rest-csrf-token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "qmgrName",
                "value": "",
                "type": "path",
                "description": "Name of the queue manager"
              },
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path",
                "description": "Subscription identifier"
              }
            ]
          },
          "docs": "Delete a subscription from the queue manager."
        }
      ]
    }
  ],
  "bundled": true
}