{
  "opencollection": "1.0.0",
  "info": {
    "name": "IBM MQ Administration REST Channels Queue Messaging API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Queue Messaging",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "IBM MQ Receive a message from a queue",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}:{port}/ibmmq/rest/v2/messaging/qmgr/:qmgrName/queue/:queueName/message",
            "headers": [
              {
                "name": "ibm-mq-rest-csrf-token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "qmgrName",
                "value": "",
                "type": "path",
                "description": "Name of the queue manager"
              },
              {
                "name": "queueName",
                "value": "",
                "type": "path",
                "description": "Name of the queue"
              },
              {
                "name": "correlationId",
                "value": "",
                "type": "query",
                "description": "Filter by correlation ID (hex-encoded)"
              },
              {
                "name": "messageId",
                "value": "",
                "type": "query",
                "description": "Filter by message ID (hex-encoded)"
              },
              {
                "name": "wait",
                "value": "",
                "type": "query",
                "description": "Maximum time in milliseconds to wait for a message"
              }
            ]
          },
          "docs": "Destructively get a message from the specified queue. The message is removed from the queue and returned in the HTTP response body."
        },
        {
          "info": {
            "name": "IBM MQ Send a message to a queue",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{host}:{port}/ibmmq/rest/v2/messaging/qmgr/:qmgrName/queue/:queueName/message",
            "headers": [
              {
                "name": "ibm-mq-rest-csrf-token",
                "value": ""
              },
              {
                "name": "ibm-mq-md-correlationId",
                "value": ""
              },
              {
                "name": "ibm-mq-md-expiry",
                "value": ""
              },
              {
                "name": "ibm-mq-md-persistence",
                "value": ""
              },
              {
                "name": "ibm-mq-md-replyTo",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "qmgrName",
                "value": "",
                "type": "path",
                "description": "Name of the queue manager"
              },
              {
                "name": "queueName",
                "value": "",
                "type": "path",
                "description": "Name of the queue"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Put a message onto the specified queue. The message body is taken from the HTTP request body. Message properties can be set via HTTP headers."
        },
        {
          "info": {
            "name": "IBM MQ Browse a message on a queue",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{host}:{port}/ibmmq/rest/v2/messaging/qmgr/:qmgrName/queue/:queueName/message",
            "headers": [
              {
                "name": "ibm-mq-rest-csrf-token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "qmgrName",
                "value": "",
                "type": "path",
                "description": "Name of the queue manager"
              },
              {
                "name": "queueName",
                "value": "",
                "type": "path",
                "description": "Name of the queue"
              },
              {
                "name": "correlationId",
                "value": "",
                "type": "query",
                "description": "Filter by correlation ID (hex-encoded)"
              },
              {
                "name": "messageId",
                "value": "",
                "type": "query",
                "description": "Filter by message ID (hex-encoded)"
              }
            ]
          },
          "docs": "Non-destructively browse a message from the queue. The message remains on the queue after being returned."
        }
      ]
    }
  ],
  "bundled": true
}