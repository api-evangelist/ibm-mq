{
  "opencollection": "1.0.0",
  "info": {
    "name": "IBM MQ Administration REST Channels Queues API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Queues",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "IBM MQ List queues",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}:{port}/ibmmq/rest/v2/admin/qmgr/:qmgrName/queue",
            "headers": [
              {
                "name": "ibm-mq-rest-csrf-token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "qmgrName",
                "value": "",
                "type": "path",
                "description": "Name of the queue manager"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter queues by name (supports wildcard *)"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter by queue type"
              },
              {
                "name": "attributes",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of attributes to return"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of status attributes to return"
              }
            ]
          },
          "docs": "Retrieve a list of queues defined on a queue manager, with optional filtering by name, type, and attribute selection."
        },
        {
          "info": {
            "name": "IBM MQ Create a queue",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{host}:{port}/ibmmq/rest/v2/admin/qmgr/:qmgrName/queue",
            "headers": [
              {
                "name": "ibm-mq-rest-csrf-token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "qmgrName",
                "value": "",
                "type": "path",
                "description": "Name of the queue manager"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new queue on the specified queue manager with the given attributes."
        },
        {
          "info": {
            "name": "IBM MQ Get queue details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}:{port}/ibmmq/rest/v2/admin/qmgr/:qmgrName/queue/:queueName",
            "headers": [
              {
                "name": "ibm-mq-rest-csrf-token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "qmgrName",
                "value": "",
                "type": "path",
                "description": "Name of the queue manager"
              },
              {
                "name": "queueName",
                "value": "",
                "type": "path",
                "description": "Name of the queue"
              },
              {
                "name": "attributes",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of attributes to return"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of status attributes to return"
              }
            ]
          },
          "docs": "Retrieve detailed information about a specific queue, including configuration attributes and runtime status."
        },
        {
          "info": {
            "name": "IBM MQ Update a queue",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{host}:{port}/ibmmq/rest/v2/admin/qmgr/:qmgrName/queue/:queueName",
            "headers": [
              {
                "name": "ibm-mq-rest-csrf-token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "qmgrName",
                "value": "",
                "type": "path",
                "description": "Name of the queue manager"
              },
              {
                "name": "queueName",
                "value": "",
                "type": "path",
                "description": "Name of the queue"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Modify attributes of an existing queue on the specified queue manager."
        },
        {
          "info": {
            "name": "IBM MQ Delete a queue",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{host}:{port}/ibmmq/rest/v2/admin/qmgr/:qmgrName/queue/:queueName",
            "headers": [
              {
                "name": "ibm-mq-rest-csrf-token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "qmgrName",
                "value": "",
                "type": "path",
                "description": "Name of the queue manager"
              },
              {
                "name": "queueName",
                "value": "",
                "type": "path",
                "description": "Name of the queue"
              }
            ]
          },
          "docs": "Delete a queue from the specified queue manager. The queue must be empty and have no open handles."
        }
      ]
    }
  ],
  "bundled": true
}